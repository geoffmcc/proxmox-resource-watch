[Unit]
Description=Daily plain-text Proxmox resource digest
After=local-fs.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/proxmox-resource-watch
ExecStart=/usr/bin/python3 /usr/local/sbin/proxmox-resource-report.py --send
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
# Mutt may need the root account's ~/.muttrc and ~/.mutt files.
# Keep its home readable while preventing writes there.
ProtectHome=read-only
PrivateTmp=true
# Permit the local Postfix sendmail wrapper to enqueue mail, if installed.
ReadWritePaths=-/var/spool/postfix/maildrop
